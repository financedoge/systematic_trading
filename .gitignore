.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.pyo
*.pyd
.env
openai_key.txt
tushare_token.txt
var/*.db
# Legacy backtest archive and rendered research output are reproducible
# artifacts kept on local disk and in the NAS full-system backup, not in git.
# Study metadata (markdown, receipt.json, protocol/acceptance JSON) stays.
var/backtests/
research/**/*.html
research/**/*.png
var/live/*
!var/live/account_snapshots/
var/live/account_snapshots/*
!var/live/account_snapshots/.gitkeep
var/log/
var/maintenance/
# Generated broker snapshots are retained on disk/backups; tracked evidence stays tracked.
var/reconciliation/ib_paper_reconciliation_*.json
var/run/
var/database-sync/
var/system-backup/
var/private/
var/dependencies/
var/market_data/fx_observations/
dist/
build/
*.egg-info/
var/execution_benchmarks/
# Bulk local data trees: reproducible/backed-up artifacts, never committed.
# Keeping them out of the tracked view also keeps Codex's file search and
# turn-diff snapshots from walking millions of files (4.8M files / 476 GB on
# 2026-10-17); see log.md 2026-10-17.
var/governance/
var/research/
var/tracked_strategies/
var/tracked_models/
# Scratch space. Never committed: these hold downloaded third-party documents
# (papers, reports) and throwaway probe scripts, which must not enter the
# repository's history or its licence surface.
tmp/
research_tmp/
