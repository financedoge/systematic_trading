.venv/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.env
openai_key.txt
tushare_token.txt
var/*.db
# Legacy backtest archive and rendered research output are reproducible
# artifacts kept on local disk and in the NAS full-system backup, not in git.
# Study metadata (markdown, receipt.json, protocol/acceptance JSON) stays.
var/backtests/
research/**/*.html
research/**/*.png
var/live/*
!var/live/account_snapshots/
var/live/account_snapshots/*
!var/live/account_snapshots/.gitkeep
var/log/
var/run/
var/database-sync/
var/system-backup/
var/private/
var/dependencies/
var/market_data/fx_observations/
dist/
build/
*.egg-info/
var/execution_benchmarks/
# Scratch space. Never committed: these hold downloaded third-party documents
# (papers, reports) and throwaway probe scripts, which must not enter the
# repository's history or its licence surface.
tmp/
research_tmp/
