ST_BASE_CURRENCY=CNH
ST_DEFAULT_ENVIRONMENT=paper
ST_IB_HOST=127.0.0.1
# TWS ports below; for IB Gateway use paper 4002 and live 4001 (live remains disabled).
ST_IB_PAPER_PORT=7497
ST_IB_LIVE_PORT=7496
ST_IB_CLIENT_ID=101
ST_IB_MARKET_DATA_CLIENT_ID=121
ST_IB_EXECUTION_SYNC_CLIENT_ID=131
ST_IB_ACCOUNT_SNAPSHOT_CLIENT_ID=141
ST_IB_HEALTH_CLIENT_ID=151
ST_IB_RECONCILIATION_CLIENT_ID=161
ST_IB_PNL_ENABLED=true
ST_IB_PNL_CLIENT_ID=201
# Optional: required when Gateway manages multiple paper accounts.
# ST_IB_PNL_ACCOUNT=DU...
ST_IB_PNL_STALE_SECONDS=15
ST_IB_PNL_RECONNECT_SECONDS=30
ST_DATA_DIR=var
ST_DATABASE_PATH=var/systematic_trading.db
ST_MARKET_DATA_STORAGE_POLICY_PATH=config/market-data-storage.json
ST_TRANSACTIONAL_STORE_BACKEND=postgres
ST_MARKET_DATA_STORE_BACKEND=clickhouse
ST_POSTGRES_HOST=127.0.0.1
ST_POSTGRES_PORT=5432
ST_POSTGRES_DATABASE=systematic_trading
ST_POSTGRES_APP_USER=st_app
ST_POSTGRES_APP_PASSWORD=
ST_POSTGRES_MIGRATOR_USER=st_migrator
ST_POSTGRES_MIGRATOR_PASSWORD=
ST_POSTGRES_OWNER_ROLE=st_owner
ST_POSTGRES_SSLMODE=prefer
ST_CLICKHOUSE_HTTP_URL=http://127.0.0.1:8123
ST_CLICKHOUSE_DATABASE=systematic_trading
ST_CLICKHOUSE_USER=st_app
ST_CLICKHOUSE_PASSWORD=
ST_AUTOMATION_MARKET_DATA_CARRY_FORWARD=false
ST_AUTOMATION_MARKET_DATA_CARRY_FORWARD_MAX_CALENDAR_DAYS=4
ST_EXECUTION_TWAP_START_TIME=09:30
ST_EXECUTION_TWAP_END_TIME=10:00
ST_EXECUTION_REBALANCE_TIMEOUT_MINUTES=30
# Absolute portfolio-weight difference; 0.02 means two percentage points.
ST_AUTOMATION_REBALANCE_DRIFT_THRESHOLD=0.02
ST_AUTOMATION_ALERT_SMTP_HOST=
ST_AUTOMATION_ALERT_SMTP_PORT=587
ST_AUTOMATION_ALERT_SMTP_USERNAME=
ST_AUTOMATION_ALERT_SMTP_PASSWORD=
ST_AUTOMATION_ALERT_SMTP_USE_TLS=true
ST_AUTOMATION_ALERT_EMAIL_FROM=
ST_AUTOMATION_ALERT_EMAIL_TO=
ST_PRIMARY_EOD_PROVIDER=
ST_PRIMARY_EOD_API_KEY=
ST_TUSHARE_TOKEN_PATH=tushare_token.txt
ST_OPENAI_API_KEY=
ST_SEC_USER_AGENT=systematic-trading/0.1
# Optional dedicated read-only connection for execution TWAP history (default IB client ID + 90).
ST_IB_BENCHMARK_CLIENT_ID=191
